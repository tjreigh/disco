{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "isolatedModules": true,
    "outDir": "./dist/game",
    "rootDir": "../src/game",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "sourceMap": false,
    "declaration": true,
    "skipLibCheck": true
  },
  "include": ["../src/game/**/*"]
}
