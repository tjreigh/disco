{
  "name": "disco-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#multiplayer-contracts": "./dist/shared/multiplayer-contracts.js",
    "#multiplayer-messages": "./dist/shared/multiplayer-messages.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:contracts": "tsc -p tsconfig.contracts.json",
    "build": "npm run clean && npm run build:contracts && tsc -p tsconfig.json",
    "predev": "npm run build:contracts",
    "dev": "tsx watch src/server.ts",
    "premigrate": "npm run build:contracts",
    "migrate": "tsx src/db/migrate.ts",
    "start": "node dist/server.js",
    "pretest": "npm run build:contracts",
    "test": "vitest run",
    "pretest:coverage": "npm run build:contracts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run build:contracts && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/websocket": "^11.3.0",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.4.0",
    "jose": "^6.0.12",
    "ws": "^8.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.14",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.20.3",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
