NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=/var/lib/disco/disco.sqlite

PUBLIC_SITE_ORIGIN=https://disco.example.com
API_ORIGIN=https://api.example.com

SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SESSION_COOKIE_NAME=disco_session
SESSION_TTL_SECONDS=2592000
COOKIE_SECURE=true

# Single-provider configuration:
OIDC_PROVIDER_ID=google
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me
OIDC_SCOPE="openid email profile"

# Or use OIDC_PROVIDERS_JSON instead of the single-provider fields above.
# Example:
# OIDC_PROVIDERS_JSON={"google":{"issuer":"https://accounts.google.com","clientId":"...","clientSecret":"...","scope":"openid email profile"}}
