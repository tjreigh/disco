NODE_ENV=development
PORT=8787
HOST=127.0.0.1
DATABASE_PATH=./data/disco.sqlite
PUBLIC_SITE_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8787
SESSION_SECRET=replace-with-at-least-32-random-characters

# Configure either OIDC_PROVIDERS_JSON or the single-provider fields below.
# OIDC_PROVIDERS_JSON='{"google":{"issuer":"https://accounts.google.com","clientId":"...","clientSecret":"...","scope":"openid email profile"}}'
OIDC_PROVIDER_ID=google
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid email profile
